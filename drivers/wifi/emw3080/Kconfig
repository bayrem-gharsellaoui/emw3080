menuconfig EMW3080
	bool "MXCHIP EMW3080 Wi-Fi driver"
	depends on WIFI
	depends on DT_HAS_MXCHIP_EMW3080_ENABLED
	select SPI
	select GPIO
	select NET_L2_WIFI_MGMT
	select WIFI_OFFLOAD
	select NET_OFFLOAD
	help
	  Enable support for the MXCHIP EMW3080 Wi-Fi module.

if EMW3080

config EMW3080_INIT_PRIORITY
	int "EMW3080 device initialization priority"
	default 60
	help
	  Initialization priority of the EMW3080 device.

module = EMW3080
module-str = emw3080
source "subsys/logging/Kconfig.template.log_config"

endif # EMW3080
